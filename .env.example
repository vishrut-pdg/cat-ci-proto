POSTGRES_DB=cat_ci
POSTGRES_USER=cat_ci
POSTGRES_PASSWORD=cat_ci_demo
DEMO_AUTH_SECRET=replace-for-shared-demos
# Local prototype only: rebuild/restart the backend with the deterministic mock dataset.
RESET_DEMO_DATA_ON_START=true
# Keep the demo's twelve-snapshot history but make the newest evidence current.
ROLL_DEMO_SNAPSHOTS_ON_START=true
# Vertex AI setup: docs/GCP_VERTEX_AI_LOCAL.md
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
# Host path mounted by Docker. Defaults to your gcloud ADC file when omitted.
GOOGLE_APPLICATION_CREDENTIALS_HOST=/absolute/path/to/.config/gcloud/application_default_credentials.json
GEMINI_MODEL=gemini-2.5-flash
# Generated executive PDFs are persisted in this local MinIO instance.
MINIO_ACCESS_KEY=cat_ci
MINIO_SECRET_KEY=replace-with-a-long-local-secret
MINIO_REPORT_BUCKET=executive-reports
